# git-crypt. ** is required: real paths are nested under hosts/<host>/_user|_root,
# and a pattern with a slash is otherwise anchored to the repo root.

**/.ssh/**       filter=git-crypt diff=git-crypt
**/ssh/**        filter=git-crypt diff=git-crypt
**/.netrc        filter=git-crypt diff=git-crypt
**/.env*         filter=git-crypt diff=git-crypt
**/*vimrc.local  filter=git-crypt diff=git-crypt
**/*.key         filter=git-crypt diff=git-crypt
**/*.pem         filter=git-crypt diff=git-crypt
